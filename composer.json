{
	"name" : "toteph42/identity_switch",
	"type" : "roundcube-plugin",
	"description" : "This plugin allows users to switch between different identities (and check for new mails) in a single Roundcube session.",
	"homepage" : "https://github.com/toteph42/identity_switch",
	"license" : "GPL-3.0-or-later",
	"keywords" : [
		"identity",
		"select identity",
		"switch user",
		"check newmail",
		"notify new mail"
	],
	"authors" : [{
			"name" : "Florian Däumling",
			"role" : "Author",
			"email" : "toteph42@wb28.de"
		}
	],
	"funding" : [{
			"type" : "other",
			"url" : "https://www.paypal.com/donate/?hosted_button_id=DS6VK49NAFHEQ"
		}
	],
	"support" : {
		"issues" : "https://github.com/toteph42/identity_switch/issues"
	},
	"repositories" : [{
			"type" : "composer",
			"url" : "https://plugins.roundcube.net"
		}
	],
	"require" : {
		"php" : ">=8.1",
		"roundcube/plugin-installer" : ">=0.1.3",
		"ext-ctype" : "*"
	},
	"conflict" : {
		"elm/identity_smtp" : "*",
		"dougluce/ident_switch" : "*"
	},
	"extra" : {
		"roundcube" : {
			"min-version" : "1.6",
			"sql-dir" : "SQL"
		}
	},
	"config" : {
		"allow-plugins" : {
			"roundcube/plugin-installer" : true
		}
	}
}